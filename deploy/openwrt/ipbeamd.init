#!/bin/sh /etc/rc.common
# procd init script for the IP-Beamer daemon on OpenWrt (install as
# /etc/init.d/ipbeamd, then `/etc/init.d/ipbeamd enable`).

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/ipbeamd
CONF=/etc/ipbeam/config.json

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" -config "$CONF"
	procd_set_param respawn          # restart if it ever exits
	procd_set_param stdout 1         # send logs to logread/syslog
	procd_set_param stderr 1
	procd_close_instance
}
